{
  "name": "webview-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "check:secrets": "node scripts/check-no-secrets.mjs",
    "dev": "vite",
    "prebuild": "npm run check:secrets",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "pretest": "npm run check:secrets",
    "test": "node --import tsx/esm --test test/*.test.ts",
    "check:i18n": "node --import tsx/esm scripts/check-i18n.mjs",
    "check:public-artifact": "node scripts/check-public-artifact.mjs",
    "check:visual-layout": "node scripts/check-visual-layout-guards.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.5.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.19.3",
    "typescript": "~5.9.3",
    "vite": "^8.0.3"
  }
}
